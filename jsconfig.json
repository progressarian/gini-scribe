{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "typeAcquisition": {
    "enable": false
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
