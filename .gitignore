node_modules/
dist/
*.env
# `*.env` matches `.env` but NOT `.env.backup-…` or `.env.local` — a copy of the
# real file kept under any other suffix is still the real file, keys and all.
.env.*
!.env.example
.vite/

# Google service-account key. This was the reason for the old blanket
# `server/*.json` rule, which also swallowed server/package.json and
# server/railway.json — both needed by the Docker build. Keep it narrow.
gini-ai-8fc66116e12e.json
server/gini-ai-*.json

# Ad-hoc debug output. One-off scripts belong in server/scripts/, and their
# dumps/logs should not come back to the repo root.
*.log
/*_debug.json

# Generated analytics reports (patient-derived output — never commit)
reports/

# E2E: the test environment file holds no secrets and must be committed; run output is not.
!e2e/.env.e2e
e2e/.artifacts/

# Billing handover exports read from production: regenerate with server/scripts/export-billing-*.mjs, never commit.
docs/gini-flow/billing-test-list*.xlsx
docs/gini-flow/billing-consultant-list*.xlsx
docs/gini-flow/billing-handover/
docs/gini-flow/billing-handover-*.zip
.~lock.*#
.claude/
